<UserControl x:Class="AuraCoursePlanner.Views.AddCourseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid VerticalAlignment="Center" HorizontalAlignment="Center">
		<Border Width="560" Style="{StaticResource CardStyle}" Padding="32">
			<StackPanel>
				<TextBlock Text="Add a New Course" Style="{StaticResource HeadingText}" FontSize="24" Margin="0,0,0,24"/>

				<!-- Top Inputs -->
				<TextBlock Text="Course Title" Style="{StaticResource SubtleText}" Margin="2,0,0,6"/>
				<TextBox Text="{Binding NewCourseTitle, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>

				<Grid Margin="0,0,0,20">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="20"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0">
						<TextBlock Text="Total Hours" Style="{StaticResource SubtleText}" Margin="2,0,0,6"/>
						<TextBox Text="{Binding NewCourseHours, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
					</StackPanel>

					<StackPanel Grid.Column="2">
						<TextBlock Text="Minutes" Style="{StaticResource SubtleText}" Margin="2,0,0,6"/>
						<TextBox Text="{Binding NewCourseMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
					</StackPanel>
				</Grid>

				<!-- Separator Section -->
				<Grid Margin="0,10,0,25">
					<Rectangle Height="1" Fill="#3F3F46" VerticalAlignment="Center"/>
					<Border Background="#1E1E24" HorizontalAlignment="Center" Padding="8,0">
						<TextBlock Text="End Date" Foreground="#9CA3AF" FontSize="12" FontWeight="SemiBold"/>
					</Border>
				</Grid>

				<!-- Date Inputs -->
				<Grid Margin="0,0,0,20">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="10"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="10"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0">
						<TextBlock Text="Day" Style="{StaticResource SubtleText}" Margin="2,0,0,6"/>
						<TextBox Text="{Binding SelectedDay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" HorizontalContentAlignment="Center"/>
					</StackPanel>

					<StackPanel Grid.Column="2">
						<TextBlock Text="Month" Style="{StaticResource SubtleText}" Margin="2,0,0,6"/>
						<TextBox Text="{Binding SelectedMonth, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" HorizontalContentAlignment="Center"/>
					</StackPanel>

					<StackPanel Grid.Column="4">
						<TextBlock Text="Year" Style="{StaticResource SubtleText}" Margin="2,0,0,6"/>
						<TextBox Text="{Binding SelectedYear, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" HorizontalContentAlignment="Center"/>
					</StackPanel>
				</Grid>

				<!-- Result -->
				<TextBlock Text="Resulting Date" Style="{StaticResource SubtleText}" Margin="2,0,0,6"/>
				<TextBox IsReadOnly="True"
                         Text="{Binding CalculatedDateString, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,28" Background="#18181B"/>

				<Button Content="Create Course" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddCourseCommand}" Height="46" FontSize="15" FontWeight="SemiBold"/>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
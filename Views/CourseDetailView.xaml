<UserControl x:Class="AuraCoursePlanner.Views.CourseDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AuraCoursePlanner.Models">

    <UserControl.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#4B4B5A" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button Click="Close_Click" Focusable="False" BorderThickness="0" Background="#000000" Opacity="0.55" Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Border HorizontalAlignment="Right" Width="440" Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,0,0,0">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{Binding Title, Mode=OneWay}" Style="{StaticResource HeadingText}" TextWrapping="Wrap"
                                   Margin="0,0,40,0"/>
                        <TextBlock Style="{StaticResource SubtleText}" Margin="0,4,0,0">
							<Run Text="Goal: "/>
							<Run Text="{Binding GoalEndDate, Mode=OneWay, StringFormat='{}{0:MMMM d, yyyy}'}"/>
							<Run Text=" · "/>
							<Run Text="{Binding RemainingScheduledDays, Mode=OneWay}"/>
							<Run Text=" study days left · "/>
							<Run Text="{Binding PriorityDisplay, Mode=OneWay}"/>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Sun" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Opacity="{Binding IsSundayScheduled, Converter={StaticResource BoolToOpacityConverter}}"/>
                            <TextBlock Text="Mon" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Opacity="{Binding IsMondayScheduled, Converter={StaticResource BoolToOpacityConverter}}"/>
                            <TextBlock Text="Tue" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Opacity="{Binding IsTuesdayScheduled, Converter={StaticResource BoolToOpacityConverter}}"/>
                            <TextBlock Text="Wed" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Opacity="{Binding IsWednesdayScheduled, Converter={StaticResource BoolToOpacityConverter}}"/>
                            <TextBlock Text="Thu" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Opacity="{Binding IsThursdayScheduled, Converter={StaticResource BoolToOpacityConverter}}"/>
                            <TextBlock Text="Fri" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Opacity="{Binding IsFridayScheduled, Converter={StaticResource BoolToOpacityConverter}}"/>
                            <TextBlock Text="Sat" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Opacity="{Binding IsSaturdayScheduled, Converter={StaticResource BoolToOpacityConverter}}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="30" Height="30" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand" FontSize="14"
                            Click="Close_Click"/>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding IsTodayCheckedIn, Mode=OneWay}"
                                      IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
								<Run Text="Today's goal: "/>
								<Run Text="{Binding DynamicDailyPaceDisplay, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Content="I did it today ✓" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right" Padding="14,8"
                                Command="{Binding MarkTodayDoneCommand}"
                                Visibility="{Binding IsTodayCheckedIn, Converter={StaticResource BoolToVisibilityConverter},
                                                     ConverterParameter=Invert}"/>
                        <TextBlock Text="✓ Checked in today" HorizontalAlignment="Right"
                                   Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsTodayCheckedIn, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <ProgressBar Style="{StaticResource ModernProgressBar}"
                                     Value="{Binding ProgressPercentage, Mode=OneWay}"/>
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="{Binding ProgressPercentageDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource SubtleText}">
								<Run Text="{Binding TotalWatched, Mode=OneWay, Converter={StaticResource TimeSpanToHmConverter}}"/>
								<Run Text=" / "/>
								<Run Text="{Binding TotalDuration, Mode=OneWay, Converter={StaticResource TimeSpanToHmConverter}}"/>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{Binding DynamicDailyPaceDisplay, Mode=OneWay}" Margin="0,10,0,0" FontWeight="SemiBold"
                                   Foreground="{Binding ProjectedToMissDeadline, Mode=OneWay,
                                                        Converter={StaticResource MissedDeadlineToBrushConverter}}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Log Today's Session" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <DatePicker SelectedDate="{Binding LogDate}" Style="{StaticResource ModernDatePicker}"
                                    Margin="0,0,0,10">
                            <DatePicker.Resources>
                                <Style TargetType="Calendar">
                                    <Setter Property="Background" Value="#22222C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#3F3F46"/>
                                </Style>
                                <Style TargetType="CalendarItem">
                                    <Setter Property="Background" Value="#22222C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                                <Style TargetType="CalendarDayButton">
                                    <Setter Property="Background" Value="#22222C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                                <Style TargetType="CalendarButton">
                                    <Setter Property="Background" Value="#22222C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Hours" Style="{StaticResource SubtleText}" Margin="2,0,0,4"/>
                                <TextBox Text="{Binding LogHours, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Minutes" Style="{StaticResource SubtleText}" Margin="2,0,0,4"/>
                                <TextBox Text="{Binding LogMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Notes (optional)" Style="{StaticResource SubtleText}" Margin="2,0,0,4"/>
                        <TextBox Text="{Binding LogNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                        <Button Content="Save Progress" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveProgressCommand}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Session History" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Sessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:StudySession}">
                                    <Border Background="#22222C" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Date, StringFormat='{}{0:MMM d, yyyy}'}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding DurationWatched,
                                                                           Converter={StaticResource TimeSpanToHmConverter}}"
                                                           Style="{StaticResource SubtleText}"/>
                                                <TextBlock Text="{Binding Notes}" Style="{StaticResource SubtleText}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding Notes, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="🗑" Background="Transparent"
                                                    BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                                                    Cursor="Hand" VerticalAlignment="Top"
                                                    Command="{Binding DataContext.DeleteSessionCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
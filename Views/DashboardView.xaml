<UserControl x:Class="AuraCoursePlanner.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AuraCoursePlanner.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel>

            <TextBlock Text="Dashboard" Style="{StaticResource HeadingText}" FontSize="26" Margin="0,0,0,20"/>

            <!-- ===== SUMMARY METRIC CARDS ===== -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="ACTIVE COURSES" Style="{StaticResource SubtleText}"/>
                        <TextBlock Text="{Binding TotalActiveCourses}" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="TOTAL HOURS WATCHED" Style="{StaticResource SubtleText}"/>
                        <TextBlock Text="{Binding TotalHoursWatched, StringFormat={}{0:0.0}h}"
                                   FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="OVERALL COMPLETION" Style="{StaticResource SubtleText}"/>
                        <TextBlock Text="{Binding OverallCompletionRate, StringFormat={}{0:0.0}%}"
                                   FontSize="30" FontWeight="Bold" Margin="0,6,0,0"
                                   Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== COURSE CARDS ===== -->
            <ItemsControl ItemsSource="{Binding Courses}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CourseViewModel}">
                        <Border Style="{StaticResource CardStyle}" Width="340" Margin="0,0,16,16" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                    Command="{Binding DataContext.SelectCourseCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            </Border.InputBindings>

                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DynamicDailyPaceDisplay}"
                                               HorizontalAlignment="Right"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding ProjectedToMissDeadline,
                                                            Converter={StaticResource MissedDeadlineToBrushConverter}}"/>
                                </Grid>

                                <ProgressBar Style="{StaticResource ModernProgressBar}"
                                             Value="{Binding ProgressPercentage, Mode=OneWay}"
                                             Margin="0,14,0,6"/>

                                <Grid>
                                    <TextBlock Text="{Binding ProgressPercentageDisplay}"
                                               Style="{StaticResource SubtleText}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource SubtleText}">
                                        <Run Text="Watched: "/>
                                        <Run Text="{Binding TotalWatched, Converter={StaticResource TimeSpanToHmConverter}, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource SubtleText}">
                                        <Run Text="Remaining: "/>
                                        <Run Text="{Binding RemainingTime, Converter={StaticResource TimeSpanToHmConverter}, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource SubtleText}">
                                        <Run Text="Goal: "/>
                                        <Run Text="{Binding GoalEndDate, StringFormat={}{0:MMM d}}"/>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
